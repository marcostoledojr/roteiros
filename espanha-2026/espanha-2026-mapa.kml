<Document>
  <name>Espanha 2026 — Aniversário Momo</name>
  <description>Roteiro completo: Madri · Toledo · Barcelona — Novembro 2026</description>

  <!-- ===== ESTILOS ===== -->
  <!-- Vermelho (monumentos/cultura) -->
  <Style id="red-pin">
    <IconStyle><color>ff1a1aaa</color><scale>1.1</scale>
      <Icon><href>https://maps.google.com/mapfiles/kml/paddle/red-circle.png</href></Icon>
    </IconStyle>
    <LabelStyle><scale>0.8</scale></LabelStyle>
  </Style>
  <!-- Laranja (gastronomia restaurantes) -->
  <Style id="orange-pin">
    <IconStyle><color>ff0060ff</color><scale>1.0</scale>
      <Icon><href>https://maps.google.com/mapfiles/kml/paddle/orange-circle.png</href></Icon>
    </IconStyle>
    <LabelStyle><scale>0.8</scale></LabelStyle>
  </Style>
  <!-- Amarelo (tapas &amp; drinks) -->
  <Style id="yellow-pin">
    <IconStyle><color>ff00c8ff</color><scale>1.0</scale>
      <Icon><href>https://maps.google.com/mapfiles/kml/paddle/ylw-circle.png</href></Icon>
    </IconStyle>
    <LabelStyle><scale>0.8</scale></LabelStyle>
  </Style>
  <!-- Azul (logística) -->
  <Style id="blue-pin">
    <IconStyle><color>ffcc3300</color><scale>1.1</scale>
      <Icon><href>https://maps.google.com/mapfiles/kml/paddle/blu-circle.png</href></Icon>
    </IconStyle>
    <LabelStyle><scale>0.8</scale></LabelStyle>
  </Style>
  <!-- Verde (hospedagem) -->
  <Style id="green-pin">
    <IconStyle><color>ff009900</color><scale>1.2</scale>
      <Icon><href>https://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href></Icon>
    </IconStyle>
    <LabelStyle><scale>0.9</scale></LabelStyle>
  </Style>

  <!-- ================================================================ -->
  <!-- CAMADA 1: LOGÍSTICA GERAL                                        -->
  <!-- ================================================================ -->
  <Folder>
    <name>✈ Logística Geral</name>
    <description>Aeroportos e estações de trem da viagem</description>
    <visibility>1</visibility>

    <Placemark>
      <name>✈ Aeroporto MAD — Adolfo Suárez Barajas</name>
      <description><![CDATA[
        <b>Aeroporto de Madri</b><br/>
        Terminal 1 (Air Europa)<br/>
        <br/>
        Chegada: 15 Nov às 05:15 (UX58 GRU→MAD)<br/>
        Transfer: Metro Linha 8 → Nuevos Ministerios → Atocha (~45 min, €5)
      ]]></description>
      <styleUrl>#blue-pin</styleUrl>
      <Point><coordinates>-3.5668,40.4774,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>✈ Aeroporto BCN — El Prat</name>
      <description><![CDATA[
        <b>Aeroporto de Barcelona</b><br/>
        Terminal 1<br/>
        <br/>
        Embarque: 21 Nov às 20:30 (UX7708 BCN→MAD)<br/>
        Transfer: Aerobus T1 → Plaça Catalunya (~30 min, €6,75)
      ]]></description>
      <styleUrl>#blue-pin</styleUrl>
      <Point><coordinates>2.0785,41.2971,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🚄 Estação Madrid Atocha</name>
      <description><![CDATA[
        <b>Madrid Puerta de Atocha</b><br/>
        Principal estação ferroviária de Madri<br/>
        <br/>
        17 Nov: Atocha 10:15 → Toledo 10:49 (Avant 08102, localizador YG59WL)<br/>
        18 Nov: Atocha 08:57 → Barcelona Sants 12:06 (AVE 03091, localizador F955FL)<br/>
        <br/>
        Chegar 30 min antes. Embarque para Toledo pela planta baja
      ]]></description>
      <styleUrl>#blue-pin</styleUrl>
      <Point><coordinates>-3.6909,40.4065,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🚄 Estação Toledo</name>
      <description><![CDATA[
        <b>Estação de Toledo</b><br/>
        Estação mudejar em frente à cidade histórica<br/>
        <br/>
        17 Nov: Toledo 18:45 → Madri Atocha 19:19 (Avant 08183, localizador YG59WL)
      ]]></description>
      <styleUrl>#blue-pin</styleUrl>
      <Point><coordinates>-4.0258,39.8543,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🚄 Estação Barcelona Sants</name>
      <description><![CDATA[
        <b>Estació de Barcelona-Sants</b><br/>
        Principal estação ferroviária de Barcelona<br/>
        <br/>
        18 Nov: Chegada 12:06 do AVE 03091 de Madri<br/>
        Metro L3 (verde) ou L5 (azul) → centro em 10 min
      ]]></description>
      <styleUrl>#blue-pin</styleUrl>
      <Point><coordinates>2.1408,41.3793,0</coordinates></Point>
    </Placemark>

  </Folder>

  <!-- ================================================================ -->
  <!-- CAMADA 2: MADRID — MONUMENTOS &amp; CULTURA                      -->
  <!-- ================================================================ -->
  <Folder>
    <name>🏛 Madrid — Monumentos &amp; Cultura</name>
    <description>Principais pontos turísticos de Madri · Dias 1-3 · 15-18 Nov</description>
    <visibility>1</visibility>

    <Placemark>
      <name>🖼 Museo del Prado</name>
      <description><![CDATA[
        <b>Museo Nacional del Prado</b><br/>
        Um dos maiores museus de arte do mundo<br/>
        <br/>
        Horário: Seg-Sáb 10h-20h / Dom 10h-19h<br/>
        Entrada: €15 (grátis após 18h em dias úteis)<br/>
        Destaques: Velázquez, Goya, Rubens, Tiziano<br/>
        <br/>
        ⭐ PRIORIDADE MÁXIMA — Reservar ingresso online
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-3.6919,40.4138,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🖼 Museo Reina Sofía</name>
      <description><![CDATA[
        <b>Museo Nacional Centro de Arte Reina Sofía</b><br/>
        Arte contemporânea e moderna<br/>
        <br/>
        Horário: Seg e Qua-Sáb 10h-21h / Dom 10h-14h30 (fechado terça)<br/>
        Entrada: €12 (grátis Seg-Sex após 19h e Sáb após 14h30)<br/>
        <br/>
        ⭐ IMPERDÍVEL: Guernica de Pablo Picasso (Sala 206)<br/>
        <br/>
        Dica: Ir de tarde para aproveitar gratuidade
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-3.6941,40.4072,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>👑 Palacio Real de Madrid</name>
      <description><![CDATA[
        <b>Palácio Real de Madri</b><br/>
        Residência oficial da Família Real Espanhola<br/>
        <br/>
        Horário: Abr-Set 10h-20h / Out-Mar 10h-18h<br/>
        Entrada: €12 / gratuito para cidadãos UE às Seg, Qua e Qui (16h-18h)<br/>
        <br/>
        Não deixar de ver: Armeria Real, Jardines de Sabatini
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-3.7143,40.4179,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🏛 Plaza Mayor</name>
      <description><![CDATA[
        <b>Plaza Mayor</b><br/>
        A praça mais famosa de Madri · Séc. XVII<br/>
        <br/>
        Entrada gratuita · Aberta 24h<br/>
        <br/>
        Ao redor: mercados, restaurantes, street performers<br/>
        Dica: Visite de manhã cedo (sem multidões) ou à noite (mais bonita)
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-3.7073,40.4155,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🌳 Parque del Retiro</name>
      <description><![CDATA[
        <b>Parque do Retiro</b><br/>
        Pulmão verde de Madri · Patrimônio UNESCO<br/>
        <br/>
        Aberto 24h · Entrada gratuita<br/>
        <br/>
        Ver: Estanque Grande (barcos a remo), Palácio de Cristal,<br/>
        Monumento a Alfonso XII, Rose Garden<br/>
        <br/>
        Ótimo para caminhada matinal no Dia 2
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-3.6843,40.4150,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🌅 Templo de Debod (Pôr do Sol)</name>
      <description><![CDATA[
        <b>Templo de Debod</b><br/>
        Templo egípcio de 2.200 anos — presente do Egito à Espanha<br/>
        <br/>
        Entrada gratuita ao exterior<br/>
        Interior: Ter-Sex 10h-14h e 18h-20h / Sáb-Dom 10h-14h<br/>
        <br/>
        ⭐ MELHOR PÔR DO SOL DE MADRI<br/>
        Vista deslumbrante para o Palácio Real<br/>
        Chegar 30 min antes do pôr do sol
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-3.7178,40.4229,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🛍 Gran Vía</name>
      <description><![CDATA[
        <b>Gran Vía</b><br/>
        A "Broadway" de Madri · Arquitetura Belle Époque<br/>
        <br/>
        Aberta 24h · Melhor à noite<br/>
        <br/>
        Ver: Edificio Metrópolis, Edificio Telefónica, Teatro Capitol<br/>
        Lojas, musicals, restaurantes e vida noturna<br/>
        <br/>
        Hotel Liabeny fica a 3 min a pé da Gran Vía
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-3.7035,40.4203,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🏘 Bairro de Malasaña</name>
      <description><![CDATA[
        <b>Malasaña</b><br/>
        Bairro bohemio, alternativo e trendy de Madri<br/>
        <br/>
        Aberto 24h · Melhor à tarde e noite<br/>
        <br/>
        Ver: Mercado de Fuencarral, ruas com grafite, cafés artesanais,<br/>
        Plaza del Dos de Mayo, lojas vintage e bares locais<br/>
        <br/>
        Ótimo para explorar no Dia 2 à tarde
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-3.7055,40.4260,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🎨 Museo Thyssen-Bornemisza</name>
      <description><![CDATA[
        <b>Museo Thyssen-Bornemisza</b><br/>
        Terceiro grande museu do "Triângulo de Ouro"<br/>
        <br/>
        Horário: Ter-Dom 10h-19h (fechado segunda)<br/>
        Entrada: €13<br/>
        <br/>
        Completa o Prado e o Reina Sofía<br/>
        Destaques: Impressionismo, Arte Moderna
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-3.6942,40.4154,0</coordinates></Point>
    </Placemark>

  </Folder>

  <!-- ================================================================ -->
  <!-- CAMADA 3: MADRID — GASTRONOMIA                                   -->
  <!-- ================================================================ -->
  <Folder>
    <name>🍽 Madrid — Gastronomia</name>
    <description>Restaurantes recomendados em Madri · 3 opções por refeição</description>
    <visibility>0</visibility>

    <!-- ALMOÇOS -->
    <Placemark>
      <name>🥘 ALMOÇO — Sobrino de Botín (Restaurante mais antigo do mundo)</name>
      <description><![CDATA[
        <b>Sobrino de Botín</b><br/>
        ⭐ Guinness: restaurante mais antigo do mundo (1725)<br/>
        Especialidade: Cochinillo asado e Cordero lechal<br/>
        <br/>
        Preço: €30-45/pessoa<br/>
        Reserva: OBRIGATÓRIA em botin.es<br/>
        Horário: 13h-16h e 20h-00h<br/>
        <br/>
        Calle de Cuchilleros, 17 · próximo à Plaza Mayor
      ]]></description>
      <styleUrl>#orange-pin</styleUrl>
      <Point><coordinates>-3.7082,40.4144,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🥘 ALMOÇO — Mercado de San Miguel</name>
      <description><![CDATA[
        <b>Mercado de San Miguel</b><br/>
        ⭐ Mercado gastronômico premium no coração de Madri<br/>
        Tapas, vinhos, frutos do mar frescos<br/>
        <br/>
        Preço: €15-25/pessoa<br/>
        Horário: 10h-00h (Qui-Sáb até 02h)<br/>
        <br/>
        Plaza de San Miguel · ao lado da Plaza Mayor<br/>
        Ótimo para almoço leve entre museus
      ]]></description>
      <styleUrl>#orange-pin</styleUrl>
      <Point><coordinates>-3.7090,40.4152,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🥘 ALMOÇO — Casa Lucio</name>
      <description><![CDATA[
        <b>Casa Lucio</b><br/>
        ⭐ Tradicional taberna madrilena desde 1974<br/>
        Famoso pelos huevos rotos e pratos castelhanos<br/>
        <br/>
        Preço: €25-40/pessoa<br/>
        Reserva recomendada<br/>
        Horário: 13h-16h e 20h30-00h<br/>
        <br/>
        Calle de la Cava Baja, 35 · La Latina
      ]]></description>
      <styleUrl>#orange-pin</styleUrl>
      <Point><coordinates>-3.7098,40.4125,0</coordinates></Point>
    </Placemark>

    <!-- JANTARES -->
    <Placemark>
      <name>🍷 JANTAR — Taberna La Daniela</name>
      <description><![CDATA[
        <b>Taberna La Daniela</b><br/>
        ⭐ Cocido madrileño autêntico — prato típico da capital<br/>
        Ambiente clássico e preços honestos<br/>
        <br/>
        Preço: €20-30/pessoa<br/>
        Horário: 13h30-16h e 20h30-23h<br/>
        <br/>
        Calle del General Pardiñas, 21<br/>
        <br/>
        O cocido madrileño é prato de inverno — perfeito para novembro!
      ]]></description>
      <styleUrl>#orange-pin</styleUrl>
      <Point><coordinates>-3.6817,40.4258,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🍷 JANTAR — La Tasquería</name>
      <description><![CDATA[
        <b>La Tasquería</b><br/>
        ⭐ 1 estrela Michelin · Chef Javi Estévez<br/>
        Cozinha criativa com offal (miúdos) de alta gastronomia<br/>
        <br/>
        Preço: €60-80/pessoa (menu degustação)<br/>
        Reserva: OBRIGATÓRIA com semanas de antecedência<br/>
        Horário: 14h-15h30 e 21h-22h30<br/>
        <br/>
        Calle del Duque de Sesto, 48
      ]]></description>
      <styleUrl>#orange-pin</styleUrl>
      <Point><coordinates>-3.6736,40.4210,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🍷 JANTAR — StreetXO</name>
      <description><![CDATA[
        <b>StreetXO</b><br/>
        ⭐ Chef Dabiz Muñoz (3 estrelas Michelin em outros restaurantes)<br/>
        Street food de alta gastronomia — fusão ibero-asiática<br/>
        <br/>
        Preço: €50-70/pessoa<br/>
        Reserva: muito difícil — tentar com meses de antecedência<br/>
        Horário: 13h30-15h30 e 20h30-23h<br/>
        <br/>
        Calle de Serrano, 52 · El Corte Inglés Premium
      ]]></description>
      <styleUrl>#orange-pin</styleUrl>
      <Point><coordinates>-3.6880,40.4298,0</coordinates></Point>
    </Placemark>

  </Folder>

  <!-- ================================================================ -->
  <!-- CAMADA 4: MADRID — TAPAS &amp; DRINKS                            -->
  <!-- ================================================================ -->
  <Folder>
    <name>🍺 Madrid — Tapas &amp; Drinks</name>
    <description>Melhores bares de tapas e drinks de Madri · Altamente recomendados</description>
    <visibility>0</visibility>

    <Placemark>
      <name>🍷 Bodega de la Ardosa ⭐4.5</name>
      <description><![CDATA[
        <b>Bodega de la Ardosa</b><br/>
        ⭐⭐ Taberna histórica desde 1892<br/>
        A melhor tortilla de patatas de Madri (segundo os locais)<br/>
        <br/>
        Preço: €2-5 por tapa · Barato e bom<br/>
        Ambiente: tradicional, azulejos, barris de vinho<br/>
        Horário: 12h30-15h30 e 19h-00h<br/>
        <br/>
        Calle de Colón, 13 · Malasaña<br/>
        Torilla com trufa: €4,50 — pedir sempre!
      ]]></description>
      <styleUrl>#yellow-pin</styleUrl>
      <Point><coordinates>-3.7054,40.4244,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🍺 Bares da Cava Baja ⭐4.4</name>
      <description><![CDATA[
        <b>Calle Cava Baja</b><br/>
        ⭐⭐ A rua de tapas mais famosa de Madri · Bairro de La Latina<br/>
        Dezenas de bares tradicionais lado a lado<br/>
        <br/>
        Melhor experiência: ir andando e "tapear" de bar em bar<br/>
        Preço: €1,50-4 por tapa<br/>
        Melhor horário: 13h-16h ou 20h-23h<br/>
        <br/>
        Favoritos: El Viajero, Txirimiri, Casa Lucas
      ]]></description>
      <styleUrl>#yellow-pin</styleUrl>
      <Point><coordinates>-3.7097,40.4127,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🌇 Azotea del Círculo de Bellas Artes ⭐4.3</name>
      <description><![CDATA[
        <b>Azotea del Círculo de Bellas Artes</b><br/>
        ⭐⭐ Rooftop mais icônico de Madri<br/>
        Vista panorâmica 360° da cidade<br/>
        <br/>
        Preço: €4 entrada + cócteis ~€10-14<br/>
        Horário: 10h-01h (Qui-Sáb até 02h)<br/>
        Ideal para pôr do sol e gin-tonic<br/>
        <br/>
        Calle de Alcalá, 42 · 7º andar<br/>
        Vai direto pelo elevador no foyer do Círculo
      ]]></description>
      <styleUrl>#yellow-pin</styleUrl>
      <Point><coordinates>-3.6985,40.4181,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🍸 El Imparcial ⭐4.4</name>
      <description><![CDATA[
        <b>El Imparcial</b><br/>
        ⭐ Bar gastronômico em antiga gráfica do séc. XIX<br/>
        Coquetéis, vermutes, tapas criativas em ambiente incrível<br/>
        <br/>
        Preço: €8-14 por cóctel · Tapas €5-10<br/>
        Horário: 13h-02h (Qui-Sáb até 03h)<br/>
        <br/>
        Calle del Duque de Alba, 4 · La Latina<br/>
        Ambiente único — espaço de 4 andares em prédio histórico
      ]]></description>
      <styleUrl>#yellow-pin</styleUrl>
      <Point><coordinates>-3.7094,40.4097,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🍺 Bar Cock ⭐4.3</name>
      <description><![CDATA[
        <b>Bar Cock</b><br/>
        ⭐ Coqueteria clássica de Madri desde 1920s<br/>
        Ambiente Art Deco, bartenders de jaleco<br/>
        Sem dúvida um dos melhores coquetéis de Madri<br/>
        <br/>
        Preço: €10-15 por drinque<br/>
        Horário: 20h-04h (fechado domingos)<br/>
        <br/>
        Calle de la Reina, 16 · Chueca<br/>
        Não tem cardápio — o bartender faz o que você quiser
      ]]></description>
      <styleUrl>#yellow-pin</styleUrl>
      <Point><coordinates>-3.7004,40.4230,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🍺 El Anciano Rey de los Vinos ⭐4.3</name>
      <description><![CDATA[
        <b>El Anciano Rey de los Vinos</b><br/>
        ⭐ Taberna histórica desde 1909 · frente ao Palácio Real<br/>
        Vinho da casa excelente, tapas clássicas, vista para a Almudena<br/>
        <br/>
        Preço: €2-4 por tapa · Vinho €2-4 por copo<br/>
        Horário: 10h-23h30<br/>
        <br/>
        Calle Bailén, 19 · Em frente ao Palácio Real<br/>
        Ótimo para uma pausa após visitar o Palácio
      ]]></description>
      <styleUrl>#yellow-pin</styleUrl>
      <Point><coordinates>-3.7131,40.4157,0</coordinates></Point>
    </Placemark>

  </Folder>

  <!-- ================================================================ -->
  <!-- CAMADA 5: TOLEDO — MONUMENTOS &amp; MIRANTES                     -->
  <!-- ================================================================ -->
  <Folder>
    <name>⚔ Toledo — Monumentos &amp; Mirantes</name>
    <description>Day trip · 17 Nov · Trem Madri-Toledo 33 min</description>
    <visibility>0</visibility>

    <Placemark>
      <name>⛪ Catedral de Toledo (Primada de España)</name>
      <description><![CDATA[
        <b>Catedral Primada de Toledo</b><br/>
        ⭐ Uma das maiores catedrais góticas do mundo (séc. XIII-XV)<br/>
        <br/>
        Entrada: €12,50 / inclui torre e sacristia<br/>
        Horário: 10h-18h30 (Dom: 14h-18h30)<br/>
        <br/>
        Destaques: Transparente barroco, coro, sacristia com El Grecos<br/>
        <br/>
        PRIORIDADE MÁXIMA em Toledo — reservar online é recomendado
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-4.0222,39.8567,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🏰 Alcázar de Toledo</name>
      <description><![CDATA[
        <b>Alcázar de Toledo</b><br/>
        ⭐ Fortaleza romana-medieval com museu militar<br/>
        Ponto mais alto de Toledo — vistas magníficas<br/>
        <br/>
        Entrada: Grátis (domingos e feriados gratuito)<br/>
        Horário: Ter-Dom 10h-17h (fechado segunda)<br/>
        <br/>
        Museu do Exército no interior<br/>
        Vista panorâmica da cidade do terraço
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-4.0209,39.8574,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>✡ Sinagoga del Tránsito + Museo Sefardí</name>
      <description><![CDATA[
        <b>Sinagoga del Tránsito</b><br/>
        ⭐ Melhor exemplo de arquitetura mudéjar judaica (1356)<br/>
        Decoração de arabescos em estuque — impressionante<br/>
        <br/>
        Entrada: €3 (grátis Dom tarde e Sáb)<br/>
        Horário: Mar-Sáb 9h30-19h30 / Dom 10h-15h<br/>
        <br/>
        Calle Samuel Levi, s/n · Judería de Toledo<br/>
        Ao lado: Casa del Greco
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-4.0268,39.8545,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🎨 Iglesia de Santo Tomé — El Greco</name>
      <description><![CDATA[
        <b>Iglesia de Santo Tomé</b><br/>
        ⭐ Abriga o maior e mais famoso quadro de El Greco:<br/>
        "El entierro del conde de Orgaz" (1586)<br/>
        <br/>
        Entrada: €3<br/>
        Horário: 10h-18h45 (Mar-Out até 19h45)<br/>
        <br/>
        Calle Santo Tomé, 4<br/>
        Uma das obras-primas da pintura espanhola
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-4.0249,39.8557,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🌅 Mirador del Valle (Pôr do Sol ÉPICO)</name>
      <description><![CDATA[
        <b>Mirador del Valle</b><br/>
        ⭐⭐ A melhor vista panorâmica de Toledo<br/>
        Toledo inteira ao pôr do sol — foto obrigatória<br/>
        <br/>
        Entrada: Gratuita<br/>
        Aberto: 24h<br/>
        <br/>
        Carretera de Circunvalación · Margem sul do Tejo<br/>
        <br/>
        Como chegar: Taxi do centro (~€5) ou caminhar 25 min<br/>
        Melhor horário: 1h antes do pôr do sol (por volta das 17h30 em Nov)
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-4.0357,39.8486,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🌉 Puente de Alcántara e Muralhas</name>
      <description><![CDATA[
        <b>Puente de Alcántara</b><br/>
        ⭐ Ponte romana (séc. I a.C.) com Torre de Homenagem<br/>
        Uma das entradas mais fotogênicas de Toledo<br/>
        <br/>
        Entrada: Gratuita<br/>
        <br/>
        Vista da muralha árabe e do Rio Tejo<br/>
        Ótimo ponto de partida para explorar a cidade histórica<br/>
        A pé da estação de trem: 20 minutos
      ]]></description>
      <styleUrl>#red-pin</styleUrl>
      <Point><coordinates>-4.0164,39.8584,0</coordinates></Point>
    </Placemark>

